__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Unpacked car data. These are derived from a car's data.acd -- for RSS and
# other paid mods that content is licensed, not ours to redistribute. Keep
# ranges files local.
ranges/

# diagnose.bat output: contains local usernames, absolute paths and a dump
# of the Claude Desktop config.
diagnose-report.txt

# A data directory kept beside the code (ASSETTO_MCP_DATA pointed here).
# The lap database is the driver's own driving, other drivers' names
# included, and nearly a gigabyte; ranges inside it are licensed car data.
/assetto-mcp-data/

# Notes about a driver and their cars. They belong in the data directory
# (<data_dir>/notes/); these catch a copy made inside the checkout.
notes/
*.local.md

# Session reports written for the driver to read. Generated from the
# database, so they are output rather than source -- and they date badly,
# since the analysis that produced them keeps changing underneath.
exports/

# Vendored CSP references, kept locally for lookups. Ilja's shipped SDK
# definitions and tobi/ac-tracer are other people's code -- useful to read
# here, not ours to redistribute.
.lua-sdk/

# Vendored CSP references, cloned by hand for API research. Not ours to ship.
/acc-lua-sdk/
/acc-lua-internal/
